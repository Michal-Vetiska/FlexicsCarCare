    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.23.1",
